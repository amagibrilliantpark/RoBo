{
  "name": "robo-desktop",
  "version": "2.0.3",
  "description": "RoBo - Roblox Studio AI Assistant",
  "main": "src/main/main.js",
  "author": "RoBo",
  "license": "AGPL-3.0",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:plugin": "node ../plugin/build.js",
    "prebuild": "node ../plugin/build.js",
    "prebuild:win": "node ../plugin/build.js",
    "prebuild:mac": "node ../plugin/build.js",
    "prebuild:linux": "node ../plugin/build.js",
    "build": "electron-builder --win --mac --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.robo.desktop",
    "productName": "RoBo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!src/**/*.map",
      "!src/**/*.log",
      "!node_modules/.cache/**/*"
    ],
    "extraResources": [
      {
        "from": "../syncro.exe",
        "to": "syncro.exe"
      },
      {
        "from": "../opencode.exe",
        "to": "opencode.exe"
      },
      {
        "from": "../SyncRo.rbxmx",
        "to": "SyncRo.rbxmx"
      },
      {
        "from": "../default.project.json",
        "to": "project/default.project.json"
      },
      {
        "from": "../opencode.json",
        "to": "project/opencode.json"
      },
      {
        "from": "../AGENTS.md",
        "to": "project/AGENTS.md"
      },
      {
        "from": "../src",
        "to": "project/src",
        "filter": [
          "**/*",
          "**/.*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../../assets/logo.ico",
      "artifactName": "${productName}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../../assets/logo.ico",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "RoBo",
      "deleteAppDataOnUninstall": true,
      "installerLanguages": [
        "en_US"
      ],
      "multiLanguageInstaller": false,
      "include": "installer-custom.nsh",
      "artifactName": "${productName} Setup.${ext}"
    }
  },
  "dependencies": {
    "unzipper": "^0.12.3",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  }
}
